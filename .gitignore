# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local runtime data (never commit secrets or scraped PII).
# Anchored with a leading slash on purpose: an unanchored `data/` matches at any
# depth and silently excluded leadgen/data/ (the shipped geo dataset and
# spam_rules.json), so a fresh clone had no data and 23 tests failed.
/data/
*.db
*.db-journal
*.sqlite
*.sqlite3
.env
.env.*
!.env.example
leadgen_state/
logs/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Builds
build/
dist/
node_modules/
