# ---------------------------------------------------------------------------
# LeadGen Studio configuration.  Copy to .env and edit.
# Every key is prefixed LEADGEN_ and maps to leadgen/config.py::Settings.
# ---------------------------------------------------------------------------

# --- app -------------------------------------------------------------------
LEADGEN_HOST=127.0.0.1
LEADGEN_PORT=8765
LEADGEN_DEBUG=false
# Where the SQLite database, encryption key and logs live.
# LEADGEN_STATE_DIR=/absolute/path/to/leadgen_state
# Override the database entirely (e.g. an existing SQLite file or Postgres URL).
# Defaults to <LEADGEN_STATE_DIR>/leadgen.db
# LEADGEN_DATABASE_URL=sqlite:////absolute/path/to/leadgen.db

# --- anti-spam pacing ------------------------------------------------------
# Google free (consumer) accounts: 500 recipients/day hard ceiling.
LEADGEN_DAILY_RECIPIENT_CAP=400
LEADGEN_HOURLY_RECIPIENT_CAP=60
LEADGEN_MIN_DELAY_SECONDS=45
LEADGEN_MAX_DELAY_SECONDS=240
LEADGEN_LONG_PAUSE_EVERY=12
LEADGEN_LONG_PAUSE_MIN_SECONDS=600
LEADGEN_LONG_PAUSE_MAX_SECONDS=1500
LEADGEN_MAX_CONSECUTIVE_FAILURES=5
LEADGEN_ENFORCE_QUIET_HOURS=false
LEADGEN_QUIET_HOURS_START=20
LEADGEN_QUIET_HOURS_END=8

# --- legal footer (CAN-SPAM requires both) ---------------------------------
LEADGEN_BUSINESS_NAME=Your Company Ltd
LEADGEN_BUSINESS_MAILING_ADDRESS=480 Commerce Ave, Suite 210, Phoenix, AZ 85004
LEADGEN_UNSUBSCRIBE_URL=

# --- optional AI copy engine ----------------------------------------------
# offline | openai | openai_compatible | anthropic
LEADGEN_LLM_PROVIDER=offline
LEADGEN_LLM_API_KEY=
LEADGEN_LLM_BASE_URL=https://api.openai.com/v1
LEADGEN_LLM_MODEL=gpt-4o-mini
LEADGEN_LLM_TIMEOUT=60

# --- scraping --------------------------------------------------------------
LEADGEN_SCRAPE_RESULTS_PER_QUERY=20
LEADGEN_SCRAPE_MAX_PAGES_PER_CAMPAIGN=60
LEADGEN_SCRAPE_REQUEST_TIMEOUT=20
LEADGEN_SCRAPE_DELAY_MIN=1.5
LEADGEN_SCRAPE_DELAY_MAX=4.0
LEADGEN_VERIFY_MX_RECORDS=true
# Identify yourself honestly; some directories block the default browser UA.
# LEADGEN_SCRAPE_USER_AGENT=Mozilla/5.0 (compatible; YourBot/1.0; +https://you.example/bot)

# --- sender warm-up --------------------------------------------------------
# New mailboxes should ramp volume gradually or they get throttled. Day one
# sends at most WARMUP_DAY1 recipients, then each further day adds
# WARMUP_DAILY_STEP, up to LEADGEN_DAILY_RECIPIENT_CAP.
LEADGEN_WARMUP_DAY1=20
LEADGEN_WARMUP_DAILY_STEP=25

# --- optional Google Places source (needs a billing-enabled key) -----------
# Leave empty and the source stays disabled; nothing is sent to Google.
LEADGEN_GOOGLE_MAPS_API_KEY=

# --- app identity (rarely changed) -----------------------------------------
# LEADGEN_APP_NAME=LeadGen Studio
# LEADGEN_VERSION=1.0.0
